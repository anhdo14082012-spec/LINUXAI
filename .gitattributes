# Giữ LF cho mọi script chạy trên Linux (tránh lỗi "bad interpreter ^M" khi commit từ Windows)
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.desktop text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.md text eol=lf
session/grom-session-start text eol=lf
*.yml text eol=lf
# Script Windows giữ CRLF
*.bat text eol=crlf
